aws_region = "us-east-1"
environment = "dev"

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

vpc_cidr = "10.0.0.0/16"

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

app_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]

db_subnet_cidrs = [
  "10.0.21.0/24",
  "10.0.22.0/24"
]

instance_type    = "t3.micro"
desired_capacity = 2
min_size         = 2
max_size         = 2

db_name                 = "appdb"
db_username             = "appadmin"
db_password             = "REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD"
db_instance_class       = "db.t4g.micro"
db_allocated_storage    = 20
backup_retention_period = 1
